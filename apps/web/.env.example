# App-owned local/single-editor mode. Both are required. Use two different
# random 32+ character values and do not reuse any other application secret.
EDITOR_LOGIN_SECRET=
EDITOR_SESSION_SECRET=

# At least 32 random characters. Used to derive participant pseudonyms,
# resumable research sessions, and opaque search-view URLs.
PILOT_SECRET=

# Optional for local exploration; required before evaluating the four-week
# gates. Use exact ISO timestamps with timezone. The end is exclusive.
PILOT_WINDOW_START=
PILOT_WINDOW_END=

# Bearer token for the scheduler-only retention maintenance endpoint.
MAINTENANCE_SECRET=

# Development only. Never enable this for a real pilot or production database.
SEED_DEMO_CONTENT=false
