# Named editor accounts. Use different random 32+ character values and keep
# them in a secret manager. The first login creates the bootstrap account;
# remove all four BOOTSTRAP values after that account can log in. Generate the
# TOTP secret as 20 random bytes encoded as Base32 (A-Z2-7, no spaces).
EDITOR_PASSWORD_PEPPER=
EDITOR_MFA_KEY_V1=
EDITOR_RATE_LIMIT_SECRET=
PRIVATE_INTAKE_KEY_V1=
EDITOR_BOOTSTRAP_EMAIL=
EDITOR_BOOTSTRAP_NAME=
EDITOR_BOOTSTRAP_PASSWORD=
EDITOR_BOOTSTRAP_TOTP_SECRET=

# Development migration fallback only. Real pilots/production must keep this
# false and must not configure the two legacy secrets after a named account
# exists. Never re-enable the shared login as an incident workaround.
EDITOR_ENABLE_LEGACY_LOGIN=false
EDITOR_LOGIN_SECRET=
EDITOR_SESSION_SECRET=

# At least 32 random characters. Used to derive participant pseudonyms,
# resumable research sessions, and opaque search-view URLs.
PILOT_SECRET=

# Optional for local exploration; required before evaluating the four-week
# gates. Use exact ISO timestamps with timezone. The end is exclusive.
PILOT_WINDOW_START=
PILOT_WINDOW_END=

# Bearer token for scheduler-only maintenance, backup-evidence, and
# recovery-drill endpoints. Keep it separate from every editor/pilot secret.
MAINTENANCE_SECRET=

# Canonical origin, without a trailing slash. A real pilot requires HTTPS.
PUBLIC_ORIGIN=

# Development only. Never enable this for a real pilot or production database.
SEED_DEMO_CONTENT=false
