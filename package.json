{
  "name": "xjtlu-unofficial-guide",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.12.0 <25" },
  "scripts": {
    "handbook:build": "node scripts/build-handbook.mjs",
    "handbook:check": "node scripts/build-handbook.mjs --check",
    "dev": "node scripts/dev.mjs",
    "start": "node server/guide.mjs",
    "build": "node scripts/build.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "preview:cold-start": "node scripts/preview-cold-start.mjs",
    "seed:cold-start": "node scripts/populate-cold-start.mjs",
    "collect:zhitiao": "node scripts/collect-zhitiao.mjs",
    "export:pages": "node scripts/export-pages.mjs",
    "sync:pages": "node scripts/sync-pages.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:platform": "node --test docs/platform-probes/runtime-0.3.0-*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 --test-timeout=60000 tests/browser/*.test.mjs",
    "test:pages-browser": "node --test --test-concurrency=1 --test-timeout=60000 tests/browser/pages.test.mjs tests/browser/quick-contributions.test.mjs tests/browser/community.test.mjs tests/browser/cold-start-search.test.mjs",
    "runtime": "node scripts/runtime.mjs",
    "migrate": "node scripts/legacy-migration.mjs",
    "migrate:restore": "node scripts/restore-migration.mjs",
    "verify:backup": "node scripts/verify-backup.mjs",
    "research:report": "node scripts/research-report.mjs"
  },
  "dependencies": {
    "@information-community/core": "file:vendor/information-community-core-0.3.0.tgz",
    "@information-community/runtime": "file:vendor/information-community-runtime-0.3.0-branches.tgz"
  }
}
