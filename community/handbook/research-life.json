      ],
      "sentences": [
        {
          "kind": "fact",
          "text": "园区校园地址是苏州工业园区仁爱路111号；太仓校园地址是太仓市太仓大道111号。",
          "sourceKeys": [
            "life-visit"
          ]
        },
        {
          "kind": "advice",
          "text": "建议先在报到邮件或活动通知中圈出校区、楼宇和房间，分别保存目的地。",
          "sourceKeys": []
        },
        {
          "kind": "advice",
          "text": "建议给接送人员发送完整中文地址，同时写明“园区校园”或“太仓校园”。",
          "sourceKeys": []
        },
        {
          "kind": "advice",
          "text": "建议订票前以自己的当年报到通知核对目的地，学院名称不能代替报到地点。",
          "sourceKeys": []
        },
        {
          "kind": "advice",
          "text": "建议寄行李前向住宿前台确认公寓收件地址和代收安排。",
          "sourceKeys": []
        }
      ],
      "cautions": [
        "校园地址不等于宿舍、快递站或活动入口地址。"
      ],
      "reviewAfterDays": 90
    },
