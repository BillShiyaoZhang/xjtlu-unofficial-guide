  "cards": [
    {
      "key": "arrival-academic-integrity-ai",
      "title": "作业使用了生成式 AI，提交前应检查什么？",
      "topic": "study",
      "summary": "先核对本门课程的任务要求，再说明自己的使用过程和引用。",
      "campuses": [
        "universal"
      ],
      "audiences": [
        "undergraduate",
        "postgraduate"
      ],
      "keywords": [
        "学术诚信",
        "生成式AI",
        "人工智能",
        "AI声明",
        "引用",
        "assignment brief",
        "module leader"
      ],
      "sentences": [
        {
          "kind": "fact",
          "text": "图书馆的 2026 年 3 月太仓 AI 素养培训介绍将学术诚信和文中引用 AI 列入提纲。",
          "sourceKeys": [
            "arrival-ai-literacy-training"
          ]
        },
        {
          "kind": "advice",
          "text": "提交前重读本次 assignment brief 和课程通知，逐项核对允许的工具、使用环节、合作范围及声明要求。",
          "sourceKeys": []
        },
        {
          "kind": "advice",
          "text": "规则不清楚时，向 module leader 说明准备使用的工具和具体用途，询问是否允许以及如何披露，并保存答复。",
          "sourceKeys": []
        },
        {
          "kind": "advice",
          "text": "为使用过程保留工具名称、使用日期、相关输入输出、自己检查和修改的记录，按课程要求整理提交材料。",
          "sourceKeys": []
        },
        {
          "kind": "advice",
          "text": "逐条回到原始资料核对 AI 输出中的文献、数据和引用，删除自己无法核验的内容。",
          "sourceKeys": []
        },
        {
          "kind": "advice",
          "text": "最终检查正文、参考文献和工具使用声明是否一致，确保自己能够解释所提交的分析与结论。",
          "sourceKeys": []
        }
      ],
      "cautions": [
        "培训介绍不是课程作业的 AI 授权；不据此判断某次使用是否合规，也不推断全校存在统一允许或禁止规则。"
      ],
      "reviewAfterDays": 30
    },
