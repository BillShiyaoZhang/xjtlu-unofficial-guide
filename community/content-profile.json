{
  "id": "xjtlu-stage1-guide",
  "entityTypes": [
    {
      "id": "answer",
      "label": "答案",
      "role": "content",
      "schema": {
        "type": "object",
        "required": ["title", "summary", "sentences", "scope", "impact", "origin", "reviewDueAt", "asOf", "verifiedAt", "reviewOwnerLabel", "scopeMode", "evidenceCoverage", "disputeStatus"],
        "properties": {
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "sentences": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["id", "kind", "text"],
              "properties": {
                "id": { "type": "string" },
                "kind": { "type": "string", "enum": ["fact", "advice"] },
                "text": { "type": "string", "minLength": 1 }
              }
            }
          },
          "impact": { "type": "string", "enum": ["low", "high"] },
          "origin": { "type": "string", "enum": ["human", "ai_draft"] },
          "scopeMode": { "type": "string", "enum": ["universal", "constrained", "unknown"] },
          "scopeIds": { "type": "array", "items": { "type": "string" } },
          "asOf": { "type": "string" },
          "verifiedAt": { "type": "string" },
          "reviewDueAt": { "type": "string" },
          "reviewOwnerId": { "type": "string" },
          "reviewOwnerLabel": { "type": "string", "minLength": 1 },
          "evidenceCoverage": { "type": "string", "enum": ["linked_only", "partial_archived", "fully_archived"] },
          "disputeStatus": { "type": "string", "enum": ["none", "reported", "confirmed"] },
          "evidenceNote": { "type": "string" },
          "searchText": { "type": "string" },
          "locale": { "type": "string" },
          "demo": { "type": "boolean" }
        }
      }
    },
    { "id": "artifact", "label": "来源", "role": "source" }
  ],
  "evidence": {
    "factualSentenceKinds": ["fact"],
    "allowedModes": ["link-only", "excerpt"],
    "excerptRights": ["permission", "open-license", "public-domain"],
    "requireCitationsOnWrite": true
  },
  "publication": { "blockedValues": { "impact": ["high"], "origin": ["ai_draft"] } },
  "scope": { "dimensions": ["campus", "audience", "academic_year"], "universal": "universal", "unknown": "unknown" },
  "search": {
    "aliases": {
      "e-bridge": ["ebridge", "教务系统", "学生系统"],
      "learning mall": ["lm", "教学平台"],
      "knowledge base": ["kb", "知识库"],
      "新生": ["new student", "到校", "入学"],
      "办事": ["学生服务", "service"],
      "西交利物浦": ["xjtlu", "西浦"]
    }
  },
  "warnings": { "reviewOverdue": "待复核：已超过维护周期，请先核对原站。" }
}
